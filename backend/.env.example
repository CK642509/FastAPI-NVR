# ── 影像來源 ─────────────────────────────────────────────
# CAMERA_URL 支援：
#   0            → 本機 webcam 索引
#   rtsp://...   → RTSP 串流
#   /path/to.mp4 → 影片檔（搭配 CAMERA_LOOP 可循環）
#   synthetic    → 內建合成影像（免攝影機即可測試）
CAMERA_NAME=cam1
CAMERA_URL=synthetic
CAMERA_LOOP=true

# ── 錄影 ─────────────────────────────────────────────────
RECORDINGS_DIR=recordings
SEGMENT_SECONDS=60
TARGET_FPS=20

# ── 合成來源畫面尺寸（CAMERA_URL=synthetic 時生效）─────────
FRAME_WIDTH=640
FRAME_HEIGHT=480

LOG_LEVEL=INFO
