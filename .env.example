# docker-compose 用的環境變數（複製為 .env；.env 已 gitignore）
# Postgres 認證；資料庫名稱固定為 nvr_db
DB_USER=nvr
DB_PASSWORD=nvr

# 影像來源（傳入 api-server 容器）
CAMERA_NAME=cam1
CAMERA_URL=synthetic
CAMERA_LOOP=true

# 錄影
SEGMENT_SECONDS=60
TARGET_FPS=20
RECORD_ON_START=false

# 注意：compose 會以 DB_USER/DB_PASSWORD 組出 api-server 的 DATABASE_URL，
# 指向 db 服務，不需在此另設 DATABASE_URL。
